SITE_URL=https://www.kitchenmadehealth.com
# Optional development/legacy fallback; production rejects localhost origins.
NEXT_PUBLIC_SITE_URL=https://www.kitchenmadehealth.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=choose-a-long-random-secret

# Optional: show the Instagram link only after a real account URL is supplied.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-account/

# The service-role key is server-only. Never expose it through a NEXT_PUBLIC_ variable.
